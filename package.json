{
  "name": "rdr2-collectors-ultimate",
  "private": true,
  "version": "1.0.0",
  "description": "RDR2 Collector's Ultimate — carte de collection personnelle, sans publicité, installable et utilisable hors ligne.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "data": "node scripts/build-data.ts",
    "icons": "node scripts/generate-icons.ts",
    "build": "npm run data && tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "upstream:sync": "node scripts/sync-upstream.ts",
    "upstream:report": "node scripts/upstream-report.ts",
    "pretest": "npm run data",
    "verify:dist": "node scripts/verify-dist.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "leaflet": "^1.9.4",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
